{
  "hooks": {
    {{- range $i, $event := . }}
    {{- if $i }},{{ end }}
    "{{ $event.Name }}": [
      {{- range $j, $row := $event.Rows }}
      {{- if $j }},{{ end }}
      {
        {{- if $row.Matcher }}
        "matcher": "{{ $row.Matcher }}",
        {{- end }}
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/skill-router-reminder.sh\" {{ $row.Mode }}"
          }
        ]
      }
      {{- end }}
    ]
    {{- end }}
  }
}
